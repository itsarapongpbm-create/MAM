# =======================================================
# MAM DESIGN AND SERVICE - Environment Variables Example
# คัดลอกไฟล์นี้เป็น .env และกรอกค่าจริงก่อนรันบน Production Server
# =======================================================
PORT=3000
NODE_ENV=production

# SQLite Database Path (สำหรับ VPS หรือ PaaS Persistent Storage Volume เช่น /data/flowaccount.db)
DB_PATH=./server/flowaccount.db

# Gmail SMTP & IMAP Configuration
ADMIN_EMAIL=your-admin@gmail.com
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-digit-gmail-app-password
SMTP_FROM="MAM DESIGN AND SERVICE <your-email@gmail.com>"
SMTP_REPLY_TO=sales@giftoryth.com
