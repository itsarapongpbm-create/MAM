# =======================================================
# MAM DESIGN AND SERVICE - Environment Variables Example
# คัดลอกไฟล์นี้เป็น .env และกรอกค่าจริงก่อนรันบน Production Server
# =======================================================
PORT=3000
NODE_ENV=production

# SQLite Database Path (Fallback)
DB_PATH=./server/flowaccount.db

# =======================================================
# PostgreSQL 16 Configuration (Docker / Cloud VPS)
# =======================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=giftory_db
POSTGRES_USER=giftory_user
POSTGRES_PASSWORD=your_secure_password
DATABASE_URL=postgresql://giftory_user:your_secure_password@localhost:5432/giftory_db

# =======================================================
# MinIO Object Storage Configuration (S3-Compatible)
# =======================================================
S3_ENDPOINT=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_secure_password
MINIO_BUCKET_PRODUCTS=giftory-products
MINIO_BUCKET_DOCUMENTS=giftory-documents
MINIO_BUCKET_SLIPS=giftory-slips

# Gmail SMTP & IMAP Configuration
ADMIN_EMAIL=your-admin@gmail.com
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-digit-gmail-app-password
SMTP_FROM="MAM DESIGN AND SERVICE <your-email@gmail.com>"
SMTP_REPLY_TO=sales@giftoryth.com
